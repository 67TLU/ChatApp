# Database
DATABASE_URL=postgresql://postgres:sudo1234@@localhost:5432/chatapp

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Redis (optional)
REDIS_URL=https://ideal-prawn-87676.upstash.io
# WebRTC STUN/TURN
TURN_SERVER_URL=turn:your-turn-server.com:3478
TURN_SERVER_USERNAME=username
TURN_SERVER_CREDENTIAL=password
# Email (dùng Ethereal cho dev - tạo free tại https://ethereal.email)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-username@ethereal.email
SMTP_PASS=your-password
SMTP_FROM=noreply@chatapp.com

# Reset password token expiry
RESET_TOKEN_EXPIRY_HOURS=1

# Email verification token expiry
VERIFY_TOKEN_EXPIRY_HOURS=24