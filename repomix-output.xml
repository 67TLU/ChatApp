      title: 'Lời mời vào nhóm',
      body: `${data.fromDisplayName} mời bạn vào nhóm ${data.groupName}`,
      actionUrl: `/groups/${data.groupId}`,
      resourceType: 'GROUP',
      resourceId: data.groupId,
      actorId: data.fromUserId,
    });
  }
}

