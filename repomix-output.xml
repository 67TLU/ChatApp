  };

  // Lời mời nhận được
  getReceivedRequests = async (req: Request, res: Response, next: NextFunction) => {
    try {
      const requests = await this.service.getReceivedRequests(req.user!.userId);

      res.json({
        success: true,
        data: requests,
      });
    } catch (error) {
