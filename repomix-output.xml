<file path="frontend/src/services/socket/socket.ts">
import { io, Socket } from 'socket.io-client';
import { config } from '@/config/env';
import { useAuthStore } from '@/stores/authStore';

class SocketService {
  private socket: Socket | null = null;

  connect() {
    if(this.socket?.connected) return true
    const token = useAuthStore.getState().accessToken;
    
    if (!token) {
      console.warn('Cannot connect socket: No access token');
      return;
    }

    this.socket = io(config.socketUrl, {
        auth: (cb) => cb({ token: useAuthStore.getState().accessToken }),
      transports: ['websocket', 'polling'],
      reconnection: true,
      reconnectionDelay: 1000,
      reconnectionAttempts: 5,
    });

    this.socket.on('connect', () => {
      console.log('✅ Socket connected');
    });

    this.socket.on('disconnect', (reason) => {
      console.log('❌ Socket disconnected:', reason);
    });

    this.socket.on('connect_error', (error) => {
      console.error('Socket connection error:', error);
    });
  }

  disconnect() {
    if (this.socket) {
      this.socket.disconnect();
      this.socket = null;
    }
  }

  getSocket() {
    return this.socket;
  }

  emit(event: string, data?: any) {
    if (this.socket) {
      this.socket.emit(event, data);
    }
  }

  on(event: string, callback: (...args: any[]) => void) {
    if (this.socket) {
      this.socket.on(event, callback);
    }
  }

  off(event: string, callback: (...args: any[]) => void) {
    if (this.socket) {
      this.socket.off(event, callback);
    }
  }
}

export const socketService = new SocketService();
</file>

<file path="frontend/src/stores/authStore.ts">
import { create } from 'zustand';
import { persist } from 'zustand/middleware';
import { apiClient } from '@/services/api/client';
import type { User, AuthTokens } from '@/types/api';

interface AuthState {
  user: User | null;
  accessToken: string | null;
  isAuthenticated: boolean;
  
  login: (email: string, password: string) => Promise<void>;
  register: (data: any) => Promise<void>;
  logout: () => void;
  refreshToken: () => Promise<void>;
  setUser: (user: User) => void;
}

export const useAuthStore = create<AuthState>()(
  persist(
    (set, get) => ({
      user: null,
      accessToken: null,
      isAuthenticated: false,

      login: async (email: string, password: string) => {
        const response = await apiClient.post('/auth/login', { email, password });
        const { accessToken, user } = response.data.data;
        
        set({
          user,
          accessToken,
          isAuthenticated: true,
        });
      },

      register: async (data: any) => {
        const response = await apiClient.post('/auth/register', data);
        // Sau khi register, có thể auto login hoặc redirect to verify email
      },

      logout: () => {
        apiClient.post('/auth/logout').catch(() => {});
        set({
          user: null,
          accessToken: null,
          isAuthenticated: false,
        });
      },

      refreshToken: async () => {
        const response = await apiClient.post('/auth/refresh');
        const { accessToken } = response.data.data;
        set({ accessToken });
      },

      setUser: (user: User) => {
        set({ user });
      },
    }),
    {
      name: 'auth-storage',
      partialize: (state) => ({ 
        accessToken: state.accessToken,
        user: state.user ,
        isAuthenticated: state.isAuthenticated, 
      }),
    }
  )
);
</file>

<file path="frontend/src/stores/callStore.ts">
import { create } from 'zustand';
import { toast } from 'sonner';
import type { CallState, CallType, IncomingCallData, CallParticipant } from '@/types/call';
import { socketService } from '@/services/socket/socket';
import { useAuthStore } from './authStore';

interface CallStoreState extends CallState {
  // Actions
  initiateCall: (targetUserId: string, callType: CallType, conversationId: string) => void;
  acceptCall: (callId: string) => void;
  rejectCall: (callId: string) => void;
  endCall: () => void;
  toggleMute: () => void;
  toggleVideo: () => void;
  toggleScreenShare: () => void;
  
  // Socket handlers
  onIncomingCall: (data: IncomingCallData) => void;
  onCallAccepted: (data: { callId: string; userId: string }) => void;
  onCallRejected: (data: { callId: string; userId: string }) => void;
  onCallEnded: (data: { callId: string; endedBy: string; reason: string }) => void;
  onMediaStateChanged: (data: { callId: string; userId: string; isMuted: boolean; isVideoOn: boolean }) => void;
   onOutgoingCall: (data: { 
    callId: string; 
    conversationId: string; 
    callType: CallType; 
    targetUserId: string;
  }) => void;
  // Reset
  resetCall: () => void;
}

const initialState: CallState = {
  callId: null,
  conversationId: null,
  callType: 'VOICE',
  status: 'IDLE',
  initiatorId: null,
  targetUserId: null,
  participants: [],
  startTime: null,
  duration: 0,
  localStream: null,
  remoteStream: null,
  screenShareStream: null,
  isMuted: false,
  isVideoOn: false,
  isScreenSharing: false,
};

export const useCallStore = create<CallStoreState>((set, get) => ({
  ...initialState,

  initiateCall: (targetUserId, callType, conversationId) => {
    const me = useAuthStore.getState().user;
    if (!me) return;

    set({
      callType,
      conversationId,
      targetUserId,
      initiatorId: me.id,
      status: 'OUTGOING',
    });

    socketService.emit('call:invite', { targetUserId, callType });
  },
  acceptCall: (callId) => {
    set({ callId, status: 'ACCEPTED' });
    socketService.emit('call:accept', { callId });
  },

  rejectCall: (callId) => {
    socketService.emit('call:reject', { callId });
    get().resetCall();
  },

  endCall: () => {
    const { callId } = get();
    if (callId) {
      socketService.emit('call:end', { callId });
    }
    
    // Cleanup media streams
    const { localStream, remoteStream, screenShareStream } = get();
    localStream?.getTracks().forEach(track => track.stop());
    remoteStream?.getTracks().forEach(track => track.stop());
    screenShareStream?.getTracks().forEach(track => track.stop());
    
    get().resetCall();
  },

  toggleMute: () => {
    const { localStream, isMuted, callId } = get();
    if (!localStream || !callId) return;

    const audioTrack = localStream.getAudioTracks()[0];
    if (audioTrack) {
      audioTrack.enabled = isMuted;
      const newMuted = !isMuted;
      set({ isMuted: newMuted });
      socketService.emit('call:toggle-media', { callId, isMuted: newMuted });
    }
  },

  toggleVideo: () => {
    const { localStream, isVideoOn, callId } = get();
    if (!localStream || !callId) return;

    const videoTrack = localStream.getVideoTracks()[0];
    if (videoTrack) {
      videoTrack.enabled = !isVideoOn;
      const newVideoOn = !isVideoOn;
      set({ isVideoOn: newVideoOn });
      socketService.emit('call:toggle-media', { callId, isVideoOn: newVideoOn });
    }
  },

  toggleScreenShare: async () => {
    const { isScreenSharing, callId } = get();
    if (!callId) return;

    if (!isScreenSharing) {
      try {
      const stream = await navigator.mediaDevices.getDisplayMedia({
        video: true, audio: false,
      });
      set({ screenShareStream: stream, isScreenSharing: true });
      // ⭐ THÊM: thay track trong PC
      const pc = (window as any).__peerConnection; // cần refactor để expose
      const videoSender = pc?.getSenders().find((s: any) => s.track?.kind === 'video');
      if (videoSender) {
        await videoSender.replaceTrack(stream.getVideoTracks()[0]);
      }
      socketService.emit('screen-share:start', { callId, sourceType: 'SCREEN' });
      stream.getVideoTracks()[0].onended = () => get().toggleScreenShare();
    } catch (error) {
      toast.error('Không thể chia sẻ màn hình');
    }
  } else {
      const { screenShareStream } = get();
      screenShareStream?.getTracks().forEach(track => track.stop());
      set({ screenShareStream: null, isScreenSharing: false });
      socketService.emit('screen-share:stop', { callId });
    }
  },
onOutgoingCall: (data: { callId: string; conversationId: string; callType: CallType; targetUserId: string }) => {
  set({
    callId: data.callId,
    conversationId: data.conversationId,
    callType: data.callType,
    targetUserId: data.targetUserId,
    status: 'OUTGOING',
  });
},

  onIncomingCall: (data) => {
    const me = useAuthStore.getState().user;
    if (!me) return;

    // Không nhận cuộc gọi từ chính mình
    if (data.caller.id === me.id) return;

    set({
      callId: data.callId,
      conversationId: data.conversationId,
      callType: data.callType,
      targetUserId: data.caller.id,
      initiatorId: data.caller.id,
      status: 'INCOMING',
    });

    // Play ringtone (optional)
    // const audio = new Audio('/sounds/ringtone.mp3');
    // audio.play();
  },

  onCallAccepted: (data) => {
    const { callId, status } = get();
    if (callId === data.callId && status === 'OUTGOING') {
      set({ status: 'ACCEPTED' });
    }
  },

  onCallRejected: (data) => {
    const { callId } = get();
    if (callId === data.callId) {
      toast.info('Cuộc gọi bị từ chối');
      get().resetCall();
    }
  },

  onCallEnded: (data) => {
    const { callId } = get();
    if (callId === data.callId) {
      // Cleanup media streams
      const { localStream, remoteStream, screenShareStream } = get();
      localStream?.getTracks().forEach(track => track.stop());
      remoteStream?.getTracks().forEach(track => track.stop());
      screenShareStream?.getTracks().forEach(track => track.stop());
      
      get().resetCall();
    }
  },

  onMediaStateChanged: (data: { callId: string; userId: string; isMuted: boolean; isVideoOn: boolean }) => {
    const { callId, participants } = get();
    if (callId !== data.callId) return;

    const updatedParticipants = participants.map(p => 
      p.userId === data.userId
        ? { ...p, isMuted: data.isMuted, isVideoOn: data.isVideoOn }
        : p
    );
    set({ participants: updatedParticipants });
  },

  resetCall: () => {
    set(initialState);
  },
}));
</file>

<file path="frontend/src/stores/chatStore.ts">
import { create } from 'zustand';
import { toast } from 'sonner';
import { conversationsApi } from '@/services/api/conversations';
import { messagesApi } from '@/services/api/messages';
import { socketService } from '@/services/socket/socket';
import { useAuthStore } from './authStore';
import type { Conversation, Message } from '@/types/chat';

const newClientId = () =>
  `c_${Date.now()}_${Math.random().toString(36).slice(2, 10)}`;

interface CursorInfo {
  nextCursor: string | null;
  hasMore: boolean;
}

interface ChatState {
  onReadReceipt: (data: any) => void;
  conversations: Conversation[];
  activeId: string | null;
  messages: Record<string, Message[]>;      // thứ tự CŨ → MỚI
  cursors: Record<string, CursorInfo>;
  typing: Record<string, string[]>;         // convId → userIds
  loadingConversations: boolean;
  loadingMessages: boolean;
  loadingMore: boolean;

  loadConversations: () => Promise<void>;
  openConversation: (id: string) => Promise<void>;
  closeConversation: () => void;
  loadMore: (conversationId: string) => Promise<void>;
  sendText: (conversationId: string, content: string) => Promise<void>;
  sendFiles: (conversationId: string, files: File[]) => Promise<void>;
  editText: (messageId: string, content: string) => Promise<void>;
  removeMessage: (messageId: string) => Promise<void>;
  toggleReaction: (messageId: string, emoji: string) => Promise<void>;
  startTyping: (conversationId: string) => void;
  stopTyping: (conversationId: string) => void;
  createDirect: (userId: string) => Promise<string | null>;

  // socket handlers
  onAck: (p: { clientMessageId: string; messageId: string; createdAt?: string }) => void;
  onFailed: (p: { clientMessageId: string; error: string }) => void;
  onNewMessage: (m: Message) => void;
  onEdited: (p: { messageId: string; content: string; editedAt: string }) => void;
  onDeleted: (p: { messageId: string }) => void;
  onReaction: (p: { messageId: string; userId: string; emoji: string; action: 'add' | 'remove' }) => void;
  onTyping: (p: { conversationId: string; userId: string; isTyping: boolean }) => void;
}

export const useChatStore = create<ChatState>((set, get) => ({
  conversations: [],
  activeId: null,
  messages: {},
  cursors: {},
  typing: {},
  loadingConversations: false,
  loadingMessages: false,
  loadingMore: false,

  loadConversations: async () => {
    set({ loadingConversations: true });
    try {
      const res = await conversationsApi.list();
      set({ conversations: res.data.data });
    } catch {
      toast.error('Không tải được danh sách hội thoại');
    } finally {
      set({ loadingConversations: false });
    }
  },

  openConversation: async (id) => {
    const prev = get().activeId;
    if (prev && prev !== id) socketService.emit('conversation:leave', { conversationId: prev });

    set({ activeId: id, loadingMessages: true });
    socketService.emit('conversation:join', { conversationId: id });

    try {
      const res = await messagesApi.list(id);
      const page = res.data.data;
      set((s) => ({
        messages: { ...s.messages, [id]: [...page.messages].reverse() },
        cursors: { ...s.cursors, [id]: { nextCursor: page.nextCursor, hasMore: page.hasMore } },
        conversations: s.conversations.map((c) =>
          c.id === id ? { ...c, unreadCount: 0 } : c
        ),
      }));
      // mark read
      const list = get().messages[id] ?? [];
      const last = list[list.length - 1];
      if (last && last.status !== 'SENDING') {
        socketService.emit('message:read', { conversationId: id, lastReadMessageId: last.id });
      }
    } catch {
      toast.error('Không tải được tin nhắn');
    } finally {
      set({ loadingMessages: false });
    }
  },

  closeConversation: () => {
    const id = get().activeId;
    if (id) socketService.emit('conversation:leave', { conversationId: id });
    set({ activeId: null });
  },

  loadMore: async (conversationId) => {
    const cursor = get().cursors[conversationId];
    if (!cursor?.hasMore || get().loadingMore) return;

    set({ loadingMore: true });
    try {
      const res = await messagesApi.list(conversationId, cursor.nextCursor ?? undefined);
      const page = res.data.data;
      set((s) => ({
        messages: {
          ...s.messages,
          [conversationId]: [...[...page.messages].reverse(), ...(s.messages[conversationId] ?? [])],
        },
        cursors: {
          ...s.cursors,
          [conversationId]: { nextCursor: page.nextCursor, hasMore: page.hasMore },
        },
      }));
    } catch {
      toast.error('Không tải được tin nhắn cũ');
    } finally {
      set({ loadingMore: false });
    }
  },

  sendText: async (conversationId, content) => {
    const text = content.trim();
    if (!text) return;

    const me = useAuthStore.getState().user;
    if (!me) return;

    const clientMessageId = newClientId();
    const optimistic: Message = {
      id: clientMessageId,
      clientMessageId,
      conversationId,
      senderId: me.id,
      content: text,
      messageType: 'TEXT',
      status: 'SENDING',
      createdAt: new Date().toISOString(),
      attachments: [],
      reactions: [],
      sender: {
        id: me.id,
        username: me.username,
        displayName: me.displayName ?? me.username,
        avatarUrl: me.avatarUrl ?? null,
      },
    };

    set((s) => ({
      messages: {
        ...s.messages,
        [conversationId]: [...(s.messages[conversationId] ?? []), optimistic],
      },
    }));

    const socket = socketService.getSocket();
    if (socket?.connected) {
      socket.emit('message:send', { conversationId, clientMessageId, content: text });
      get().stopTyping(conversationId);
    } else {
      try {
        const res = await messagesApi.send(conversationId, { clientMessageId, content: text });
        get().onAck({
          clientMessageId,
          messageId: res.data.data.message.id,
          createdAt: res.data.data.message.createdAt,
        });
      } catch {
        get().onFailed({ clientMessageId, error: 'Gửi thất bại' });
      }
    }
  },

  sendFiles: async (conversationId, files) => {
    if (!files.length) return;
    try {
      const res = await messagesApi.upload(conversationId, files, newClientId());
      const msg = res.data.data.message;
      set((s) => ({
        messages: {
          ...s.messages,
          [conversationId]: [
            ...(s.messages[conversationId] ?? []),
            { ...msg, attachments: msg.attachments ?? [], reactions: [] },
          ],
        },
      }));
      toast.success('Đã gửi file');
    } catch {
      toast.error('Upload thất bại');
    }
  },

  editText: async (messageId, content) => {
    const socket = socketService.getSocket();
    if (socket?.connected) {
      socket.emit('message:edit', { messageId, content });
    } else {
      await messagesApi.edit(messageId, content);
    }
  },

  removeMessage: async (messageId) => {
    const socket = socketService.getSocket();
    if (socket?.connected) {
      socket.emit('message:delete', { messageId, deleteFor: 'EVERYONE' });
    } else {
      await messagesApi.remove(messageId);
    }
  },

  toggleReaction: async (messageId, emoji) => {
    const state = get();
    const me = useAuthStore.getState().user;
    const convId = state.activeId;
    if (!convId || !me) return;

    const msg = (state.messages[convId] ?? []).find((m) => m.id === messageId);
    const reacted = msg?.reactions.find((r) => r.emoji === emoji)
      ?.users.some((u) => u.userId === me.id);

    socketService.emit('message:react', {
      conversationId: convId,
      messageId,
      emoji,
      action: reacted ? 'remove' : 'add',
    });
  },

  startTyping: (conversationId) => {
    socketService.emit('typing:start', { conversationId });
  },

  stopTyping: (conversationId) => {
    socketService.emit('typing:stop', { conversationId });
  },

  createDirect: async (userId) => {
    try {
      const res = await conversationsApi.createDirect(userId);
      const id = res.data.data.conversationId;
      await get().loadConversations();
      await get().openConversation(id);
      return id;
    } catch (e: any) {
      toast.error(e?.response?.data?.error?.message ?? 'Không tạo được hội thoại');
      return null;
    }
  },

  // ===== SOCKET HANDLERS =====

  onAck: ({ clientMessageId, messageId, createdAt }) => {
    set((s) => {
      const next: Record<string, Message[]> = {};
      for (const [cid, list] of Object.entries(s.messages)) {
        next[cid] = list.map((m) =>
          m.clientMessageId === clientMessageId
            ? { ...m, id: messageId, status: 'SENT', createdAt: createdAt ?? m.createdAt }
            : m
        );
      }
      return { messages: next };
    });
  },

  onFailed: ({ clientMessageId, error }) => {
    set((s) => {
      const next: Record<string, Message[]> = {};
      for (const [cid, list] of Object.entries(s.messages)) {
        next[cid] = list.map((m) =>
          m.clientMessageId === clientMessageId ? { ...m, status: 'FAILED' } : m
        );
      }
      return { messages: next };
    });
    toast.error(error || 'Gửi tin nhắn thất bại');
  },

onNewMessage: (m) => {
  const me = useAuthStore.getState().user;
  const { activeId } = get();
  const normalized: Message = {
    ...m,
    attachments: m.attachments ?? [],
    reactions: m.reactions ?? [],
  };

  set((s) => {
    const list = s.messages[m.conversationId] ?? [];
    // Nếu tin nhắn đã tồn tại thì không làm gì cả
    if (list.some((x) => x.id === m.id)) return s;

    // Kiểm tra xem conversation này đã có trong danh sách chưa
    const exists = s.conversations.some((c) => c.id === m.conversationId);

    return {
      messages: {
        ...s.messages,
        [m.conversationId]: [...list, normalized],
      },
      conversations: exists
        ? s.conversations.map((c) =>
            c.id === m.conversationId
              ? {
                  ...c,
                  lastMessagePreview: m.content ?? '[Tệp đính kèm]',
                  lastMessageAt: m.createdAt,
                  unreadCount:
                    activeId === m.conversationId || m.senderId === me?.id
                      ? 0
                      : (c.unreadCount ?? 0) + 1,
                }
              : c
          )
        : [
            // ⭐ Nếu chưa có, tạo mới conversation và đẩy lên đầu danh sách
            {
              id: m.conversationId,
              type: 'DIRECT', // Tạm thời gán DIRECT, backend sẽ sync đúng type sau
              name: null,
              avatarUrl: null,
              lastMessagePreview: m.content ?? '[Tệp đính kèm]',
              lastMessageAt: m.createdAt,
              unreadCount: 1,
              otherUser: m.sender
                ? {
                    userId: m.sender.id,
                    username: m.sender.username ?? 'unknown',
                    displayName: m.sender.displayName,
                    avatarUrl: m.sender.avatarUrl,
                  }
                : null,
            },
            ...s.conversations,
          ],
    };
  });

  // Tự động mark read nếu đang mở đúng conversation đó
  if (activeId === m.conversationId && m.senderId !== me?.id) {
    socketService.emit('message:read', {
      conversationId: m.conversationId,
      lastReadMessageId: m.id,
    });
  }
  },

  onReadReceipt: (data) => {
    // TODO: Implement read receipt UI
    console.log('Read receipt:', data);
  },

  onEdited: ({ messageId, content, editedAt }) => {
    set((s) => {
      const next: Record<string, Message[]> = {};
      for (const [cid, list] of Object.entries(s.messages)) {
        next[cid] = list.map((m) =>
          m.id === messageId ? { ...m, content, status: 'EDITED', editedAt } : m
        );
      }
      return { messages: next };
    });
  },

  onDeleted: ({ messageId }) => {
    set((s) => {
      const next: Record<string, Message[]> = {};
      for (const [cid, list] of Object.entries(s.messages)) {
        next[cid] = list.map((m) =>
          m.id === messageId
            ? { ...m, status: 'DELETED', content: null, deletedAt: new Date().toISOString() }
            : m
        );
      }
      return { messages: next };
    });
  },

  onReaction: ({ messageId, userId, emoji, action }) => {
    set((s) => {
      const next: Record<string, Message[]> = {};
      for (const [cid, list] of Object.entries(s.messages)) {
        next[cid] = list.map((m) => {
          if (m.id !== messageId) return m;
          let reactions = [...m.reactions];
          const idx = reactions.findIndex((r) => r.emoji === emoji);

          if (action === 'add') {
            if (idx === -1) {
              reactions.push({ emoji, count: 1, users: [{ userId, username: null, displayName: null }] });
            } else if (!reactions[idx].users.some((u) => u.userId === userId)) {
              reactions[idx] = {
                ...reactions[idx],
                count: reactions[idx].count + 1,
                users: [...reactions[idx].users, { userId, username: null, displayName: null }],
              };
            }
          } else if (idx !== -1) {
            const users = reactions[idx].users.filter((u) => u.userId !== userId);
            if (users.length === 0) reactions = reactions.filter((_, i) => i !== idx);
            else reactions[idx] = { ...reactions[idx], count: users.length, users };
          }
          return { ...m, reactions };
        });
      }
      return { messages: next };
    });
  },

  onTyping: ({ conversationId, userId, isTyping }) => {
    const me = useAuthStore.getState().user;
    if (userId === me?.id) return;
    set((s) => {
      const current = s.typing[conversationId] ?? [];
      const next = isTyping
        ? Array.from(new Set([...current, userId]))
        : current.filter((id) => id !== userId);
      return { typing: { ...s.typing, [conversationId]: next } };
    });
  },
}));
</file>

