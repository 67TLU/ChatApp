import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Textarea } from '@/components/ui/textarea';
import { Checkbox } from '@/components/ui/checkbox';
import { Avatar, AvatarFallback, AvatarImage } from '@/components/ui/avatar';
import { ScrollArea } from '@/components/ui/scroll-area';
import { Label } from '@/components/ui/label';
import { useFriendStore } from '@/stores/friendStore';
import { useGroupStore } from '@/stores/groupStore';
import { useChatStore } from '@/stores/chatStore';
import { Loader2, Search, Users } from 'lucide-react';

interface Props {
  open: boolean;
  onOpenChange: (open: boolean) => void;
}

export function CreateGroupDialog({ open, onOpenChange }: Props) {
  const { friends, isLoadingFriends, loadFriends } = useFriendStore();
  const createGroup = useGroupStore((s) => s.createGroup);
  const openConversation = useChatStore((s) => s.openConversation);

  const [name, setName] = useState('');
  const [description, setDescription] = useState('');
  const [selected, setSelected] = useState<string[]>([]);
  const [q, setQ] = useState('');
  const [creating, setCreating] = useState(false);

  useEffect(() => {
    if (open) loadFriends();
  }, [open, loadFriends]);

  const filtered = useMemo(() => {
    const keyword = q.toLowerCase();
    return friends.filter(
      (f) =>
        f.friend.username.toLowerCase().includes(keyword) ||
        (f.friend.displayName ?? '').toLowerCase().includes(keyword)
    );
  }, [friends, q]);

  const toggle = (id: string) => {
    setSelected((prev) =>
      prev.includes(id) ? prev.filter((x) => x !== id) : [...prev, id]
    );
  };

  const reset = () => {
    setName('');
    setDescription('');
    setSelected([]);
    setQ('');
  };

  const submit = async () => {
    if (!name.trim() || selected.length === 0 || creating) return;
    setCreating(true);
    const conversationId = await createGroup({
      name: name.trim(),
      description: description.trim() || undefined,
      memberIds: selected,
    });
    setCreating(false);
    if (conversationId) {
      onOpenChange(false);
      reset();
      await openConversation(conversationId);
    }
  };

  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent className="sm:max-w-md">
        <DialogHeader>
          <DialogTitle className="flex items-center gap-2">
            <Users className="size-5" />
            Tạo nhóm mới
          </DialogTitle>
        </DialogHeader>

        <div className="space-y-4">
          <div className="space-y-2">
            <Label>Tên nhóm *</Label>
            <Input
              value={name}
              onChange={(e) => setName(e.target.value)}
              placeholder="Nhập tên nhóm..."
              maxLength={100}
            />
          </div>

          <div className="space-y-2">
            <Label>Mô tả (tùy chọn)</Label>
            <Textarea
              value={description}
              onChange={(e) => setDescription(e.target.value)}
              placeholder="Nhóm này về..."
              rows={2}
              maxLength={500}
            />
          </div>

          <div className="space-y-2">
            <Label>
              Chọn thành viên * ({selected.length} đã chọn)
            </Label>

            <div className="relative">
              <Search className="absolute left-3 top-1/2 size-4 -translate-y-1/2 text-muted-foreground" />
              <Input
                value={q}
                onChange={(e) => setQ(e.target.value)}
                placeholder="Tìm bạn bè..."
                className="pl-9"
              />
            </div>

            <ScrollArea className="h-56 rounded-md border">
              {isLoadingFriends ? (
                <div className="flex justify-center py-8">
                  <Loader2 className="size-5 animate-spin" />
                </div>
              ) : filtered.length === 0 ? (
                <p className="py-8 text-center text-sm text-muted-foreground">
                  {friends.length === 0
                    ? 'Bạn chưa có bạn bè nào. Hãy kết bạn trước!'
                    : 'Không tìm thấy bạn bè phù hợp'}
                </p>
              ) : (
                <div className="p-2">
                  {filtered.map((f) => (
                    <div
                      key={f.friendshipId}
                      className="flex cursor-pointer items-center gap-3 rounded-md p-2 hover:bg-muted/50"
                      onClick={() => toggle(f.friend.id)}
                    >
                      <Checkbox
                        checked={selected.includes(f.friend.id)}
                        onCheckedChange={() => toggle(f.friend.id)}
                      />
                      <Avatar className="size-8">
                        <AvatarImage src={f.friend.avatarUrl || undefined} />
                        <AvatarFallback>
                          {f.friend.username[0]?.toUpperCase()}
                        </AvatarFallback>
                      </Avatar>
                      <div className="min-w-0 flex-1">
                        <p className="truncate text-sm font-medium">
                          {f.friend.displayName || f.friend.username}
                        </p>
                        <p className="truncate text-xs text-muted-foreground">
                          @{f.friend.username}
                        </p>
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </ScrollArea>
          </div>
        </div>

        <DialogFooter>
          <Button variant="outline" onClick={() => onOpenChange(false)}>
            Hủy
          </Button>
          <Button
            onClick={submit}
            disabled={!name.trim() || selected.length === 0 || creating}
          >
            {creating && <Loader2 className="mr-2 size-4 animate-spin" />}
            Tạo nhóm
          </Button>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  );
}
</file>

<file path="frontend/src/components/groups/GroupInfoSheet.tsx">
import { useEffect, useState } from 'react';
import {
  Sheet, SheetContent, SheetHeader, SheetTitle,
} from '@/components/ui/sheet';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Textarea } from '@/components/ui/textarea';
import { Avatar, AvatarFallback, AvatarImage } from '@/components/ui/avatar';
import { Badge } from '@/components/ui/badge';
import { ScrollArea } from '@/components/ui/scroll-area';
import { Separator } from '@/components/ui/separator';
import {
  DropdownMenu, DropdownMenuContent, DropdownMenuItem, DropdownMenuTrigger,
} from '@/components/ui/dropdown-menu';
import { useGroupStore } from '@/stores/groupStore';
import { useAuthStore } from '@/stores/authStore';
import { useChatStore } from '@/stores/chatStore';
import { AddMembersDialog } from './AddMembersDialog';
import { toast } from 'sonner';
import {
  Ban, Copy, Crown, Loader2, LogOut, MoreHorizontal,
  Pencil, Trash2, UserPlus, UserX, Users, X,
} from 'lucide-react';

interface Props {
  conversationId: string;
  open: boolean;
  onOpenChange: (open: boolean) => void;
}

export function GroupInfoSheet({ conversationId, open, onOpenChange }: Props) {
  const me = useAuthStore((s) => s.user);
  const {
    currentGroup: group,
    isLoadingGroup,
    loadGroupByConversation,
    clearCurrentGroup,
    updateGroup,
    deleteGroup,
    leaveGroup,
    kickMember,
    banMember,
    createInvite,
  } = useGroupStore();
  const { closeConversation } = useChatStore();

  const [addMembersOpen, setAddMembersOpen] = useState(false);
  const [editing, setEditing] = useState(false);
  const [editName, setEditName] = useState('');
  const [editDesc, setEditDesc] = useState('');

  useEffect(() => {
    if (open) {
      loadGroupByConversation(conversationId);
    } else {
      clearCurrentGroup();
    }
  }, [open, conversationId, loadGroupByConversation, clearCurrentGroup]);

  const members = group?.members ?? [];
  const roles = group?.roles ?? [];

  // ===== Phân quyền (đồng bộ logic với backend) =====
  const isOwner = !!group && !!me && group.ownerId === me.id;
  const myMembership = me ? members.find((m) => m.userId === me.id) : undefined;
  const myRole = myMembership?.roleId
    ? roles.find((r) => r.id === myMembership.roleId)
    : undefined;
  const myPermissions = myRole?.permissions ?? [];

  const canManage = isOwner || myPermissions.includes('KICK_MEMBERS');
  const canInvite = isOwner || myPermissions.includes('INVITE_MEMBERS');
  const canEdit = isOwner || myPermissions.includes('MANAGE_GROUP');

  /** Kiểm tra có thể tác động (kick/ban) lên user khác không — dựa trên hierarchy */
  const canActOn = (targetUserId: string): boolean => {
    if (!me || !group || targetUserId === me.id) return false;
    if (targetUserId === group.ownerId) return false; // Không ai tác động được owner
    if (isOwner) return true;
    const target = members.find((m) => m.userId === targetUserId);
    const targetRole = target?.roleId
      ? roles.find((r) => r.id === target.roleId)
      : undefined;
    return (myRole?.position ?? 40) > (targetRole?.position ?? 40);
  };

  // ===== Actions =====
  const handleInvite = async () => {
    if (!group) return;
    const code = await createInvite(group.id);
    if (code) {
      try {
        await navigator.clipboard.writeText(code);
        toast.success('Đã copy mã mời', { description: `Mã: ${code}` });
      } catch {
        toast.info(`Mã mời: ${code}`);
      }
    }
  };

  const startEdit = () => {
    if (!group) return;
    setEditName(group.name);
    setEditDesc(group.description ?? '');
    setEditing(true);
  };

  const saveEdit = async () => {
    if (!group || !editName.trim()) return;
    const ok = await updateGroup(group.id, {
      name: editName.trim(),
      description: editDesc.trim() || undefined,
    });
    if (ok) setEditing(false);
  };

  const handleKick = async (userId: string) => {
    if (!group) return;
    const ok = await kickMember(group.id, userId);
    if (ok) await loadGroupByConversation(conversationId);
  };

  const handleBan = async (userId: string) => {
    if (!group) return;
    const ok = await banMember(group.id, userId);
    if (ok) await loadGroupByConversation(conversationId);
  };

  const handleLeave = async () => {
    if (!group) return;
    if (!window.confirm('Bạn có chắc muốn rời nhóm này?')) return;
    const ok = await leaveGroup(group.id);
    if (ok) {
      onOpenChange(false);
      closeConversation();
    }
  };

  const handleDelete = async () => {
    if (!group) return;
    if (!window.confirm('Xóa nhóm? Toàn bộ tin nhắn và thành viên sẽ bị ảnh hưởng. Hành động này KHÔNG thể hoàn tác!')) return;
    const ok = await deleteGroup(group.id);
    if (ok) {
      onOpenChange(false);
      closeConversation();
    }
  };

  const memberName = (m: (typeof members)[number]) =>
    m.displayName || m.username;

  return (
    <Sheet open={open} onOpenChange={onOpenChange}>
      <SheetContent side="right" className="w-full sm:max-w-md">
        <SheetHeader className="border-b pb-4">
          <SheetTitle className="flex items-center gap-2">
            <Users className="size-5" />
            Thông tin nhóm
          </SheetTitle>
        </SheetHeader>

        {isLoadingGroup || !group ? (
          <div className="flex flex-1 items-center justify-center">
            <Loader2 className="size-6 animate-spin text-muted-foreground" />
          </div>
        ) : (
          <div className="flex flex-1 flex-col gap-4 overflow-y-auto p-4">
            {/* ===== Thông tin cơ bản ===== */}
            <div className="flex items-start gap-4">
              <Avatar className="size-16">
                <AvatarImage src={group.avatarUrl || undefined} />
                <AvatarFallback className="text-xl">
                  {group.name[0]?.toUpperCase()}
                </AvatarFallback>
              </Avatar>

              <div className="min-w-0 flex-1">
                {editing ? (
                  <div className="space-y-2">
                    <Input
                      value={editName}
                      onChange={(e) => setEditName(e.target.value)}
                      maxLength={100}
                    />
                    <Textarea
                      value={editDesc}
                      onChange={(e) => setEditDesc(e.target.value)}
                      placeholder="Mô tả nhóm..."
                      rows={2}
                      maxLength={500}
                    />
                    <div className="flex gap-2">
                      <Button size="sm" onClick={saveEdit}>Lưu</Button>
                      <Button size="sm" variant="outline" onClick={() => setEditing(false)}>
                        <X className="size-3" />
                      </Button>
                    </div>
                  </div>
                ) : (
                  <>
                    <div className="flex items-center gap-2">
                      <h3 className="truncate text-lg font-semibold">{group.name}</h3>
                      {canEdit && (
                        <Button size="icon-xs" variant="ghost" onClick={startEdit}>
                          <Pencil className="size-3" />
                        </Button>
                      )}
                    </div>
                    {group.description && (
                      <p className="mt-1 text-sm text-muted-foreground">
                        {group.description}
                      </p>
                    )}
                    <p className="mt-1 text-xs text-muted-foreground">
                      {group.memberCount ?? members.length} thành viên
                    </p>
                  </>
                )}
              </div>
            </div>

            {/* ===== Actions nhanh ===== */}
            <div className="flex flex-wrap gap-2">
              {canInvite && (
                <Button size="sm" variant="outline" onClick={handleInvite}>
                  <Copy className="mr-1 size-4" />
                  Copy mã mời
                </Button>
              )}
              {canInvite && (
                <Button size="sm" variant="outline" onClick={() => setAddMembersOpen(true)}>
                  <UserPlus className="mr-1 size-4" />
                  Thêm thành viên
                </Button>
              )}
            </div>

            <Separator />

            {/* ===== Danh sách thành viên ===== */}
            <div className="flex-1">
              <h4 className="mb-2 text-sm font-medium">
                Thành viên ({members.length})
              </h4>
              <ScrollArea className="max-h-80">
                <div className="space-y-1">
                  {members.map((m) => (
                    <div
                      key={m.userId}
                      className="group flex items-center gap-3 rounded-md p-2 hover:bg-muted/50"
                    >
                      <Avatar className="size-9">
                        <AvatarImage src={m.avatarUrl || undefined} />
                        <AvatarFallback>
                          {m.username[0]?.toUpperCase()}
                        </AvatarFallback>
                      </Avatar>

                      <div className="min-w-0 flex-1">
                        <div className="flex items-center gap-1.5">
                          <span className="truncate text-sm font-medium">
                            {memberName(m)}
                          </span>
                          {m.userId === me?.id && (
                            <span className="text-xs text-muted-foreground">(bạn)</span>
                          )}
                          {m.userId === group.ownerId && (
                            <Crown className="size-3.5 shrink-0 text-yellow-500" />
                          )}
                        </div>
                        {m.roleName && m.userId !== group.ownerId && (
                          <Badge
                            variant="secondary"
                            className="mt-0.5 text-[10px]"
                            style={m.roleColor ? { color: m.roleColor } : undefined}
                          >
                            {m.roleName}
                          </Badge>
                        )}
                      </div>

                      {/* Actions lên thành viên khác (nếu có quyền) */}
                      {canManage && canActOn(m.userId) && (
                        <DropdownMenu>
                          <DropdownMenuTrigger asChild>
                            <Button
                              size="icon-xs"
                              variant="ghost"
                              className="opacity-0 transition-opacity group-hover:opacity-100"
                            >
                              <MoreHorizontal className="size-4" />
                            </Button>
                          </DropdownMenuTrigger>
                          <DropdownMenuContent align="end">
                            <DropdownMenuItem
                              className="text-destructive focus:text-destructive"
                              onClick={() => handleKick(m.userId)}
                            >
                              <UserX className="size-4" />
                              Kick khỏi nhóm
                            </DropdownMenuItem>
                            <DropdownMenuItem
                              className="text-destructive focus:text-destructive"
                              onClick={() => handleBan(m.userId)}
                            >
                              <Ban className="size-4" />
                              Ban khỏi nhóm
                            </DropdownMenuItem>
                          </DropdownMenuContent>
                        </DropdownMenu>
                      )}
                    </div>
                  ))}
                </div>
              </ScrollArea>
            </div>

            <Separator />

            {/* ===== Actions nguy hiểm ===== */}
            <div className="space-y-2">
              {!isOwner && (
                <Button
                  variant="outline"
                  className="w-full text-destructive hover:text-destructive"
                  onClick={handleLeave}
                >
                  <LogOut className="mr-2 size-4" />
                  Rời nhóm
                </Button>
              )}
              {isOwner && (
                <Button
                  variant="outline"
                  className="w-full text-destructive hover:text-destructive"
                  onClick={handleDelete}
                >
                  <Trash2 className="mr-2 size-4" />
                  Xóa nhóm (Owner)
                </Button>
              )}
            </div>
          </div>
        )}

        {/* Dialog thêm thành viên (con) */}
        {group && (
          <AddMembersDialog
            groupId={group.id}
            conversationId={conversationId}
            existingMemberIds={members.map((m) => m.userId)}
            open={addMembersOpen}
            onOpenChange={setAddMembersOpen}
          />
        )}
      </SheetContent>
    </Sheet>
  );
}
</file>

<file path="frontend/src/components/groups/JoinGroupDialog.tsx">
import { useState } from 'react';
import {
  Dialog, DialogContent, DialogFooter, DialogHeader, DialogTitle, DialogDescription,
} from '@/components/ui/dialog';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { useGroupStore } from '@/stores/groupStore';
import { KeyRound, Loader2 } from 'lucide-react';

interface Props {
  open: boolean;
  onOpenChange: (open: boolean) => void;
}

/** Tách mã mời từ chuỗi người dùng dán vào (hỗ trợ cả URL /invite/xxx) */
const extractCode = (input: string): string => {
  const trimmed = input.trim();
  const match = trimmed.match(/invite\/([a-f0-9]{16})/i);
  return match ? match[1] : trimmed;
};

export function JoinGroupDialog({ open, onOpenChange }: Props) {
  const joinByCode = useGroupStore((s) => s.joinByCode);
  const [code, setCode] = useState('');
  const [joining, setJoining] = useState(false);

  const submit = async () => {
    const extracted = extractCode(code);
    if (extracted.length !== 16 || joining) return;

    setJoining(true);
    const ok = await joinByCode(extracted);
    setJoining(false);

    if (ok) {
      onOpenChange(false);
      setCode('');
    }
  };

  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent className="sm:max-w-sm">
        <DialogHeader>
          <DialogTitle className="flex items-center gap-2">
            <KeyRound className="size-5" />
            Tham gia nhóm
          </DialogTitle>
          <DialogDescription>
            Nhập mã mời (16 ký tự) hoặc dán link mời bạn nhận được
          </DialogDescription>
        </DialogHeader>

        <Input
          value={code}
          onChange={(e) => setCode(e.target.value)}
          placeholder="Dán mã mời hoặc link..."
          onKeyDown={(e) => {
            if (e.key === 'Enter') submit();
          }}
          autoFocus
        />

        <DialogFooter>
          <Button variant="outline" onClick={() => onOpenChange(false)}>
            Hủy
          </Button>
          <Button onClick={submit} disabled={extractCode(code).length !== 16 || joining}>
            {joining && <Loader2 className="mr-2 size-4 animate-spin" />}
            Tham gia
          </Button>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  );
}
</file>

<file path="frontend/src/components/notifications/NotificationBell.tsx">
import { useState, useRef, useEffect } from 'react';
import { Button } from '@/components/ui/button';
import { Bell } from 'lucide-react';
import { useNotificationStore } from '@/stores/notificationStore';
import { NotificationDropdown } from './NotificationDropdown';

export function NotificationBell() {
  const [open, setOpen] = useState(false);
  const { unreadCount } = useNotificationStore();
  const dropdownRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    const handleClickOutside = (event: MouseEvent) => {
      if (dropdownRef.current && !dropdownRef.current.contains(event.target as Node)) {
        setOpen(false);
      }
    };

    if (open) {
      document.addEventListener('mousedown', handleClickOutside);
    }

    return () => {
      document.removeEventListener('mousedown', handleClickOutside);
    };
  }, [open]);

  return (
    <div className="relative" ref={dropdownRef}>
      <Button
        variant="ghost"
        size="icon"
        className="size-12 relative"
        onClick={() => setOpen(!open)}
      >
        <Bell className="size-5" />
        {unreadCount > 0 && (
          <span className="absolute top-1 right-1 bg-red-500 text-white text-xs rounded-full size-5 flex items-center justify-center">
            {unreadCount > 99 ? '99+' : unreadCount}
          </span>
        )}
      </Button>

      {open && <NotificationDropdown onClose={() => setOpen(false)} />}
    </div>
  );
}
</file>

<file path="frontend/src/components/notifications/NotificationDropdown.tsx">
import { useEffect } from 'react';
import { ScrollArea } from '@/components/ui/scroll-area';
import { Button } from '@/components/ui/button';
import { Avatar, AvatarFallback, AvatarImage } from '@/components/ui/avatar';
import { useNotificationStore } from '@/stores/notificationStore';
import { CheckCheck, X } from 'lucide-react';
import type { Notification } from '@/services/api/notifications';
import { formatDate } from '@/lib/utils';
import { useNavigate } from 'react-router-dom';
interface Props {
  onClose: () => void;
}

export function NotificationDropdown({ onClose }: Props) {
  const {
    notifications,
    unreadCount,
    isLoading,
    loadNotifications,
    markAsRead,
    markAllAsRead,
    deleteNotification,
  } = useNotificationStore();
const navigate = useNavigate()
  useEffect(() => {
    loadNotifications();
  }, [loadNotifications]);

  const handleNotificationClick = (notification: Notification) => {
    if (!notification.isRead) {
      markAsRead(notification.id);
    }

    if (notification.actionUrl) {
      navigate(notification.actionUrl);
      onClose();
    }
  };

  const getIcon = (type: string) => {
    switch (type) {
      case 'FRIEND_REQUEST':
        return '👋';
      case 'FRIEND_ACCEPTED':
        return '🎉';
      case 'MENTION':
        return '💬';
      case 'CALL_MISSED':
        return '📞';
      case 'GROUP_INVITE':
        return '👥';
      default:
        return '🔔';
    }
  };

  return (
    <div className="absolute right-0 top-full mt-2 w-96 bg-popover border rounded-lg shadow-lg z-50">
      {/* Header */}
      <div className="flex items-center justify-between p-4 border-b">
        <h3 className="font-semibold">Thông báo</h3>
        {unreadCount > 0 && (
          <Button
            variant="ghost"
            size="sm"
            onClick={() => markAllAsRead()}
            className="text-xs"
          >
            <CheckCheck className="size-4 mr-1" />
            Đánh dấu tất cả đã đọc
          </Button>
        )}
      </div>

      {/* Content */}
      <ScrollArea className="max-h-[500px]">
        {isLoading ? (
          <div className="p-8 text-center text-muted-foreground">
            Đang tải...
          </div>
        ) : notifications.length === 0 ? (
          <div className="p-8 text-center text-muted-foreground">
            Không có thông báo nào
          </div>
        ) : (
          <div className="divide-y">
            {notifications.map((notification) => (
              <div
                key={notification.id}
                className={`flex gap-3 p-4 hover:bg-muted/50 cursor-pointer transition-colors ${
                  !notification.isRead ? 'bg-primary/5' : ''
                }`}
                onClick={() => handleNotificationClick(notification)}
              >
                <Avatar className="size-10 shrink-0">
                  <AvatarImage src={notification.actorAvatarUrl || undefined} />
                  <AvatarFallback>
                    {notification.actorDisplayName?.[0]?.toUpperCase() || '?'}
                  </AvatarFallback>
                </Avatar>

                <div className="flex-1 min-w-0">
                  <div className="flex items-start justify-between gap-2">
                    <div className="flex-1">
                      <p className="text-sm font-medium">
                        {getIcon(notification.type)} {notification.title}
                      </p>
                      {notification.body && (
                        <p className="text-sm text-muted-foreground mt-1">
                          {notification.body}
                        </p>
                      )}
                      <p className="text-xs text-muted-foreground mt-1">
                        {formatDate(notification.createdAt)}
                      </p>
                    </div>

                    {!notification.isRead && (
                      <span className="size-2 bg-primary rounded-full shrink-0 mt-2" />
                    )}
                  </div>
                </div>

                <Button
                  variant="ghost"
                  size="icon"
                  className="size-8 shrink-0"
                  onClick={(e) => {
                    e.stopPropagation();
                    deleteNotification(notification.id);
                  }}
                >
                  <X className="size-4" />
                </Button>
              </div>
            ))}
          </div>
        )}
      </ScrollArea>
    </div>
  );
}
</file>

